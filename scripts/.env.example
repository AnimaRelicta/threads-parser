# Настройки парсера Threads. Скопируйте файл в scripts/.env. Строки с # игнорируются.
# Пути указываются относительно корня проекта.

# --- Сетка n x m -------------------------------------------------------------
# Аккаунты (n): имена из реестра в БД через запятую (accounts.py list).
# Пусто = ВСЕ активные аккаунты.
ACCOUNTS=

# Воркеров (m) на каждый аккаунт: у аккаунта ОДИН браузер, а воркер это пара вкладок
# (лента профиля + посты). Воркеры одновременно обрабатывают РАЗНЫЕ профили из общей
# очереди. Всего одновременно n x m профилей.
WORKERS_PER_ACCOUNT=1

# false — окна браузера видны; true — без окон (на сервере).
# Предварительно: uv run scripts/accounts.py check --headless
HEADLESS=false

# Сколько секунд ждать ручного входа (accounts.py add / relogin)
LOGIN_TIMEOUT_SEC=300

# --- Параметры запуска по умолчанию ----------------------------------------------
# То же, что флаги run.py: флаг в командной строке перекрывает значение отсюда
# (для переключателей есть и обратная форма: --no-comments, --no-with-videos,
# --no-headless, --no-debug).

# Сколько подходящих постов (веток) брать на профиль, 0 = все. Пусто = 10 для обычного
# прогона и --threads-only, все для --fill-threads
LIMIT=
# Только посты не старше периода: 30d, 4w, 1m (календарный месяц), 1y или дата 2026-09-01.
# Пусто = без ограничения по дате
SINCE=
# Собирать комментарии деревом; глубина (1 = ответы на пост, -1 = вся вложенность)
COMMENTS=false
DEPTH=2
# Максимум комментариев на пост (0 = все)
MAX_COMMENTS=0
# Посты младше N дней перепроверяются на новые комментарии при каждом запуске (0 = выкл.)
RECHECK_DAYS=7
# Брать посты с видео (по умолчанию только текст и фото)
WITH_VIDEOS=false
# Паузы, сек (реальная пауза случайная: от значения до значения x2 между постами и x1.5 между
# профилями). Меньше = быстрее, но выше риск 429; при 429 поднимайте, смотрите scripts/db/progress.sql
DELAY=2
PROFILE_DELAY=8
# Режим «только новое»: после первого прохода у профиля есть anchor.json, и обход
# останавливается после стольких подряд известных постов (--full отключает)
STOP_AFTER_KNOWN=5
# Подробный лог дозагрузки и отладочные файлы
DEBUG=false

# --- Пути ------------------------------------------------------------------------
PROFILES_FILE=data/threads_profiles.txt
# Старый реестр: нужен только для разового `dbadmin.py import-accounts`
ACCOUNTS_FILE=data/accounts.json
COOKIES_DIR=data/cookies
EXPORT_DIR=data/export
# Свои запросы для export.py (формат в самом файле)
EXPORT_QUERIES_FILE=data/export_queries.sql
OUTPUT_DIR=data/output

# --- scripts/search.py: поиск по выдаче Threads -----------------------------
SEARCH_QUERIES_FILE=data/threads_queries.txt
# Только сырые данные для --recon; результаты поиска пишутся в Postgres
SEARCH_OUTPUT_DIR=output/search
# Воркеров в общей очереди задач поиска (запрос x режим x окно дат)
SEARCH_WORKERS=3
# Резать период на окна по N дней (0 = одно окно на весь период)
SEARCH_WINDOW_DAYS=0

# Postgres: схема создаётся командой `uv run scripts/cli.py db migrate`.
# Реальный пароль только в scripts/.env (файл в .gitignore)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME

# --- LLM-классификация ---------------------------------------------------------
# Классификация профилей: uv run scripts/cli.py classify --limit 50
# URL и ключ proxy API модели (формат OpenAI chat/completions) только в scripts/.env
LLM_PROXY_URL=
LLM_PROXY_API_KEY=
LLM_MODEL=
# Таймаут одного запроса, сек
LLM_TIMEOUT_SEC=60
# Повторов при 429/5xx/таймауте (с нарастающей паузой)
LLM_MAX_RETRIES=3
# Профилей одновременно
LLM_WORKERS=2
# Сколько последних веток профиля отправлять модели
LLM_SAMPLE_THREADS=10

# --- Локация из текста профиля (колонка profiles.text_location, миграция 016) --------
# Где искать город/страну КЗ и УЗ: title (название профиля), name (имя из «Об этом профиле»),
# bio, description (описание профиля), threads (самые частые места в текстах его веток;
# слабый сигнал, по умолчанию выключен). Пересчёт по БД: scripts/geo.py textloc
TEXT_GEO_SOURCES=title,name,bio,description

# --- Спам-детектор -------------------------------------------------------------
# Профиль с таким числом подписчиков и больше спамом не считается и не банится.
# 0 = порог отключён (подписчики не учитываются). Нужна миграция 007.
SPAM_MIN_FOLLOWERS=1000

# Классы спам-профилей (метка в profiles.spam_class, бан не выставляют), см. README.
# Сколько самых свежих веток профиля идёт в детекцию
SPAM_CLASS_SAMPLE=10
# Класс 3: часто постит, мало комментариев и подписчиков меньше этого числа
SPAM_CLASS_LOW_FOLLOWERS=100
# Постит «часто», если медиана паузы между ветками меньше стольких часов
SPAM_CLASS_GAP_HOURS=24
# Комментариев «много» (класс 1): медиана ответов под ветками >= этого
SPAM_CLASS_MANY_REPLIES=20
# Комментариев «мало» (классы 2 и 3): медиана ответов <= этого
SPAM_CLASS_FEW_REPLIES=5

# --- Прокси ------------------------------------------------------------------
# Общий прокси для всех аккаунтов; пусто = без прокси. У аккаунта можно задать свой:
# колонка proxy в таблице accounts (accounts.py proxy NAME URL), приоритет выше общего.
# Chromium не поддерживает SOCKS5 с логином/паролем: для такого прокси поднимите
# локальный форвардер и укажите socks5://127.0.0.1:порт. Для http(s)://user:pass@host:port
# логин и пароль передаются браузеру автоматически.
PROXY=